# Hasura (same instance/DB citrineos-operator-ui already uses)
NEXT_PUBLIC_API_URL=http://localhost:8090/v1/graphql
HASURA_ADMIN_SECRET=

# Auth (must match citrineos-operator-ui's own values so sessions/tokens are interchangeable)
NEXT_PUBLIC_AUTH_PROVIDER=generic
NEXT_PUBLIC_ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXTAUTH_URL=https://<operator-ui-domain>/extensions/ops-tools/proxy
NEXTAUTH_SECRET=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
NEXT_PUBLIC_KEYCLOAK_URL=
KEYCLOAK_SERVER_URL=

# Must match the manifest's id: /extensions/{id}/proxy
NEXT_PUBLIC_BASE_PATH=/extensions/ops-tools/proxy
