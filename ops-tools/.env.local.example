# Hasura (same instance/DB citrineos-operator-ui already uses)
NEXT_PUBLIC_API_URL=http://localhost:8090/v1/graphql
HASURA_ADMIN_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=

# Auth provider: 'keycloak' (SSO, shared session with Operator-UI) or 'generic'
# (single hardcoded admin, for local dev without Keycloak access)
NEXT_PUBLIC_AUTH_PROVIDER=keycloak

# Keycloak (realm AI-Charge-Technologies, client 'internal' — shared with
# citrineos-operator-ui so navigating between the two apps doesn't require a
# second login)
NEXT_PUBLIC_KEYCLOAK_URL=https://login.ai-charge.net
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=AI-Charge-Technologies
KEYCLOAK_CLIENT_ID=internal
KEYCLOAK_CLIENT_SECRET=

# Only used when NEXT_PUBLIC_AUTH_PROVIDER=generic
NEXT_PUBLIC_ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Maps (used by the Locations page — map view / location picker)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ADDRESS_API_KEY=
GOOGLE_MAPS_LOCATION_PICKER_MAP_ID=
